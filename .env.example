DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=
CONTAINER_NAME=

# Порты на хосте для docker compose
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- MinIO (S3-совместимое хранилище фото) ---
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=mgts-objects
S3_REGION=us-east-1
# Локальный запуск backend без Docker. В docker-compose переопределяется на http://minio:9000.
S3_ENDPOINT=http://localhost:9000
